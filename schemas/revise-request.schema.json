{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/revise-request.schema.json",
  "title": "ReviseRequest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "previousSpec",
    "previousDirections",
    "instruction",
    "targetMode",
    "preserveOtherDirections"
  ],
  "properties": {
    "previousSpec": {
      "$ref": "visual-spec.schema.json"
    },
    "previousDirections": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "$ref": "compile-response.schema.json#/properties/directions/items"
      },
      "allOf": [
        {
          "contains": {
            "type": "object",
            "required": ["mode"],
            "properties": {
              "mode": {
                "const": "faithful"
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "required": ["mode"],
            "properties": {
              "mode": {
                "const": "creative"
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "required": ["mode"],
            "properties": {
              "mode": {
                "const": "experimental"
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        }
      ]
    },
    "instruction": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "targetMode": {
      "type": ["string", "null"],
      "enum": ["faithful", "creative", "experimental", null]
    },
    "preserveOtherDirections": {
      "type": "boolean"
    }
  }
}
