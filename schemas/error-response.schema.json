{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/error-response.schema.json",
  "title": "ErrorResponse",
  "type": "object",
  "additionalProperties": false,
  "required": ["requestId", "error"],
  "properties": {
    "requestId": {
      "type": "string",
      "format": "uuid"
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "retryable", "details"],
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "INVALID_REQUEST",
            "CONFLICTING_CONSTRAINTS",
            "MODEL_OUTPUT_INVALID",
            "MODEL_TIMEOUT",
            "RATE_LIMITED",
            "UPSTREAM_ERROR",
            "CONTENT_REJECTED",
            "PAYLOAD_TOO_LARGE",
            "SERVICE_UNAVAILABLE"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "retryable": {
          "type": "boolean"
        },
        "details": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
