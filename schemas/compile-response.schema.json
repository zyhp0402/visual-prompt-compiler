{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/compile-response.schema.json",
  "title": "CompileResponse",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "requestId",
    "schemaVersion",
    "promptVersion",
    "normalizedBrief",
    "needsInput",
    "riskFlags",
    "directions",
    "usage"
  ],
  "properties": {
    "requestId": {
      "type": "string",
      "format": "uuid",
      "minLength": 1
    },
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "promptVersion": {
      "type": "string",
      "minLength": 1
    },
    "normalizedBrief": {
      "$ref": "visual-spec.schema.json"
    },
    "needsInput": {
      "type": "boolean"
    },
    "riskFlags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "directions": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "mode",
          "name",
          "concept",
          "differenceAxes",
          "fullPrompt",
          "compactPrompt",
          "negativeConstraints",
          "assumptions",
          "riskFlags",
          "scores"
        ],
        "properties": {
          "mode": {
            "type": "string",
            "enum": ["faithful", "creative", "experimental"]
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "concept": {
            "type": "string",
            "minLength": 1
          },
          "differenceAxes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "fullPrompt": {
            "type": "string",
            "minLength": 1
          },
          "compactPrompt": {
            "type": "string",
            "minLength": 1
          },
          "negativeConstraints": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "assumptions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "riskFlags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "scores": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "fidelity",
              "subjectClarity",
              "composition",
              "hierarchy",
              "lightingMaterialCoherence",
              "typographyFeasibility",
              "constraintControl",
              "directionDistinctness",
              "originalityRisk"
            ],
            "properties": {
              "fidelity": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              },
              "subjectClarity": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              },
              "composition": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              },
              "hierarchy": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              },
              "lightingMaterialCoherence": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              },
              "typographyFeasibility": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              },
              "constraintControl": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              },
              "directionDistinctness": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              },
              "originalityRisk": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              }
            }
          }
        }
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "latencyMs"],
      "properties": {
        "model": {
          "type": "string",
          "minLength": 1
        },
        "latencyMs": {
          "type": "integer",
          "minimum": 0
        },
        "inputTokens": {
          "type": "integer",
          "minimum": 0
        },
        "outputTokens": {
          "type": "integer",
          "minimum": 0
        },
        "estimatedCost": {
          "type": "number",
          "minimum": 0
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "needsInput": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "directions": {
            "type": "array",
            "maxItems": 0
          }
        }
      },
      "else": {
        "properties": {
          "directions": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "allOf": [
              {
                "contains": {
                  "type": "object",
                  "required": ["mode"],
                  "properties": {
                    "mode": {
                      "const": "faithful"
                    }
                  }
                },
                "minContains": 1,
                "maxContains": 1
              },
              {
                "contains": {
                  "type": "object",
                  "required": ["mode"],
                  "properties": {
                    "mode": {
                      "const": "creative"
                    }
                  }
                },
                "minContains": 1,
                "maxContains": 1
              },
              {
                "contains": {
                  "type": "object",
                  "required": ["mode"],
                  "properties": {
                    "mode": {
                      "const": "experimental"
                    }
                  }
                },
                "minContains": 1,
                "maxContains": 1
              }
            ]
          }
        }
      }
    }
  ]
}
