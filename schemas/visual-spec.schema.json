{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/visual-spec.schema.json",
  "title": "VisualSpec",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "taskType",
    "goal",
    "deliverable",
    "aspectRatio",
    "outputLanguage",
    "mandatoryText",
    "mandatoryElements",
    "forbiddenElements",
    "subject",
    "sceneGraph",
    "visualHierarchy",
    "composition",
    "lighting",
    "palette",
    "materials",
    "background",
    "styleDNA",
    "qualityRequirements",
    "assumptions",
    "unresolvedQuestions",
    "riskFlags"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "taskType": {
      "type": "string",
      "enum": [
        "poster",
        "photography",
        "product_concept",
        "three_d_scene",
        "infographic",
        "character_design",
        "image_edit",
        "storyboard",
        "general"
      ]
    },
    "goal": {
      "type": "string",
      "minLength": 1
    },
    "audience": {
      "type": "string"
    },
    "deliverable": {
      "type": "string",
      "minLength": 1
    },
    "aspectRatio": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "value"],
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["preset", "custom", "auto"]
        },
        "value": {
          "type": ["string", "null"]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "auto"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "value": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "outputLanguage": {
      "type": "string",
      "minLength": 2
    },
    "mandatoryText": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["text", "mustMatchExactly"],
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1
          },
          "mustMatchExactly": {
            "type": "boolean"
          },
          "placement": {
            "type": "string"
          },
          "hierarchy": {
            "type": "string"
          }
        }
      }
    },
    "mandatoryElements": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "forbiddenElements": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary", "attributes"],
      "properties": {
        "primary": {
          "type": "string",
          "minLength": 1
        },
        "attributes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "actions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "sceneGraph": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "element", "region", "scale", "relationships"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "element": {
            "type": "string",
            "minLength": 1
          },
          "region": {
            "type": "string",
            "minLength": 1
          },
          "scale": {
            "type": "string",
            "minLength": 1
          },
          "relationships": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "visualHierarchy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primaryFocus", "secondaryElements", "readingOrder"],
      "properties": {
        "primaryFocus": {
          "type": "string",
          "minLength": 1
        },
        "secondaryElements": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "readingOrder": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "composition": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "camera": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "viewpoint": {
          "type": "string"
        },
        "lens": {
          "type": "string"
        },
        "framing": {
          "type": "string"
        },
        "depth": {
          "type": "string"
        }
      }
    },
    "lighting": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "palette": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary", "accent", "contrastStrategy"],
      "properties": {
        "primary": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "accent": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "contrastStrategy": {
          "type": "string"
        }
      }
    },
    "materials": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "background": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "styleDNA": {
      "type": "object",
      "additionalProperties": false,
      "required": ["media", "designSystem", "spatialLanguage", "mood"],
      "properties": {
        "media": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "designSystem": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "spatialLanguage": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "timeCharacter": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "graphicLanguage": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "mood": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "typography": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "strategy": {
          "type": "string"
        },
        "fontClass": {
          "type": "string"
        },
        "alignment": {
          "type": "string"
        },
        "legibilityRequirements": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "qualityRequirements": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["statement", "confidence", "impact"],
        "properties": {
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "impact": {
            "type": "string",
            "enum": ["low", "medium", "high"]
          }
        }
      }
    },
    "unresolvedQuestions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["question", "blocking"],
        "properties": {
          "question": {
            "type": "string",
            "minLength": 1
          },
          "blocking": {
            "type": "boolean"
          }
        }
      }
    },
    "riskFlags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "taskSpecific": {
      "type": "object"
    }
  }
}
